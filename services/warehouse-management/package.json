{
  "name": "ultra-sakti-warehouse",
  "version": "1.0.0",
  "description": "Mock Warehouse Management System for PT Ultra Sakti - Bun + Elysia + SQLite",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run client/build.ts && bun run --watch src/index.ts",
    "start": "bun run client/build.ts && bun run src/index.ts",
    "build:ui": "bun run client/build.ts",
    "seed": "bun run src/db/seed.ts",
    "db:reset": "rm -f warehouse.db && bun run src/db/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/swagger": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "elysia": "^1.3.0",
    "elysiajs-mcp": "^0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.3"
  }
}
